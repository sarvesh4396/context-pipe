# Local Environment Variables for Testing
# Copy this to .env.local if needed (most tools auto-load from this)

# Redis (matches docker-compose.yml and .github/workflows/ci.yml)
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (matches docker-compose.yml and .github/workflows/ci.yml)
DATABASE_URL=postgresql://context_pipe_test:test_password@localhost:5432/context_pipe_test

# Optional: for development
ENVIRONMENT=development
DEBUG=true
